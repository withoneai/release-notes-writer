# Your One API key. After `one init`, find it in ~/.one/config.json (apiKey)
# or in the dashboard at https://app.withone.ai
ONE_SECRET=

# Your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Connection key from `one --agent list` (the `key` field for Linear)
ONE_CONNECTION_LINEAR=

# Connection key from `one --agent list` (the `key` field for Notion)
ONE_CONNECTION_NOTION=

# The Notion page the draft gets created under. Open the page in Notion,
# copy the 32-character id out of its URL.
NOTION_PARENT_PAGE_ID=

# Optional: restrict to one Linear team by key (e.g. ENG). Default: every team the connection can see.
# TEAM_KEY=

# Optional: how many days back counts as "this week" (default 7)
# LOOKBACK_DAYS=7

# Optional: how many completed issues to pull, oldest-completed first (default 100)
# ISSUE_LIMIT=100

# Optional: override the Claude model (default claude-opus-5)
# CLAUDE_MODEL=claude-opus-5
